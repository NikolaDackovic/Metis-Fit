# GRIT API - copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Postgres connection used by the API (Supabase: Settings → Database → connection string, session mode).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Supabase project URL - JWTs are verified against its JWKS (asymmetric signing keys).
SUPABASE_URL=https://<project-ref>.supabase.co
# Optional: legacy HS256 JWT secret (only if the project still uses the shared secret).
SUPABASE_JWT_SECRET=
# Comma-separated list of allowed browser origins (admin panel, website).
CORS_ORIGINS=http://localhost:5180,http://localhost:4321
# Owner/manager must use MFA (aal2) for /admin routes. Only disable locally.
REQUIRE_MFA_FOR_ADMIN=true

# LOCAL DEVELOPMENT ONLY: POST /v1/dev/login for users created by `pnpm db:dev` (needs SUPABASE_JWT_SECRET).
# Rejected at startup unless NODE_ENV=development.
DEV_LOGIN=false

# HMAC secret for QR access tokens (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_TOKEN_SECRET=

# Uploaded images. 'local' = disk (development). Staging/production must use 'supabase':
# a PUBLIC Storage bucket (MEDIA_BUCKET) written with SUPABASE_SERVICE_ROLE_KEY.
MEDIA_STORE=local
MEDIA_BUCKET=club-media
MEDIA_DIR=.tmp/media
MEDIA_PUBLIC_URL=http://localhost:4000/media

# Claude API key for AI meal plans in the nutrition wizard. Optional: without it members
# still get their calorie/macro targets, only the example meals are missing.
ANTHROPIC_API_KEY=
AI_NUTRITION_MODEL=claude-opus-5-5

# Notifications (F8). PUSH_PROVIDER=none keeps only the in-app inbox; 'expo' sends push through
# the Expo push service (needs an EAS build of the app). EXPO_ACCESS_TOKEN is optional.
PUSH_PROVIDER=none
EXPO_ACCESS_TOKEN=
NOTIFICATION_JOBS=true

# Café (F9): the POS / fiscal webhook URL is set in the admin (Kafić → Podešavanja);
# its HMAC signing secret lives only here.
CAFE_POS_SECRET=

# Staff invites (F10 production): Supabase service-role key, server only. Without it, local dev
# creates staff accounts directly in the dev database.
SUPABASE_SERVICE_ROLE_KEY=
STAFF_INVITE_REDIRECT_URL=
