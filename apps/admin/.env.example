# GRIT admin - copy to .env.local
VITE_API_URL=http://localhost:4000/v1
# 'supabase' (real auth, MFA) or 'dev' (local only, needs API DEV_LOGIN=true and `pnpm db:dev`)
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon key only. NEVER put the service_role key in a frontend.
VITE_SUPABASE_ANON_KEY=
# Public URL of the member app (web): table QR codes open <url>/order/<code>
VITE_MEMBER_APP_URL=http://localhost:8081
