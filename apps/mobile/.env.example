# GRIT mobile - copy to .env.local (EXPO_PUBLIC_* values are bundled into the app: never put secrets here)
# On a physical phone use your computer's LAN IP instead of localhost, e.g. http://192.168.1.20:4000/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
# 'supabase' (real auth) or 'dev' (local only; needs API DEV_LOGIN=true and `pnpm db:dev`)
EXPO_PUBLIC_AUTH_MODE=supabase
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
