{
  "name": "grit-digital-club",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo run lint typecheck test build --concurrency=1",
    "db:dev": "pnpm --filter @grit/database db:dev",
    "dev:api": "pnpm --filter @grit/api dev",
    "dev:admin": "pnpm --filter @grit/admin dev",
    "dev:mobile": "pnpm --filter @grit/mobile start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/windows-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/darwin-arm64",
      "esbuild"
    ],
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0"
    }
  }
}
